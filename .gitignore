# Jekyll build output and caches
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore the directory for local files during development
local/

# Gemfile.lock is committed (unlike the upstream template) so local and CI builds
# resolve the same gem versions.

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Ignore the main.min.js since it should be built as part of jekyll-build.yml
assets/js/main.min.js

# Private and source documents that must never be published
/private/
*.doc
*.docx
.env
.env.*
*.log
